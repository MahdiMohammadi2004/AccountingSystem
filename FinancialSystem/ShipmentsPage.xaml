<Page x:Class="FinancialSystem.ShipmentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ترانسپورت و گمرک">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="مدیریت محموله‌ها و ترانسپورت" FontSize="24" FontWeight="Bold" 
                   Foreground="#333" Margin="0,0,0,20"/>
        
        <DataGrid x:Name="dgShipments" Grid.Row="1" AutoGenerateColumns="True"
                  CanUserAddRows="False" IsReadOnly="True"
                  AlternatingRowBackground="#F5F5F5"/>
    </Grid>
</Page>
