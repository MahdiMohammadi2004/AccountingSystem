<Window x:Class="FinancialSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سیستم مدیریت مالی و حسابداری" Height="700" Width="1000"
        WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Sidebar Menu -->
        <Border Grid.Column="0" Background="#2C3E50">
            <DockPanel>
                <TextBlock Text="منوی اصلی" FontSize="18" FontWeight="Bold" 
                           Foreground="White" HorizontalAlignment="Center" 
                           Margin="0,20,0,20" DockPanel.Dock="Top"/>
                
                <StackPanel DockPanel.Dock="Top">
                    <Button Content="داشبورد" Height="40" Margin="10,5" 
                            Click="BtnDashboard_Click" Background="#34495E" 
                            Foreground="White" BorderThickness="0"/>
                    <Button Content="بیلانس عمومی" Height="40" Margin="10,5" 
                            Click="BtnGeneralBalance_Click" Background="#34495E" 
                            Foreground="White" BorderThickness="0"/>
                    <Button Content="روزنامه‌چه" Height="40" Margin="10,5" 
                            Click="BtnJournal_Click" Background="#34495E" 
                            Foreground="White" BorderThickness="0"/>
                    <Button Content="حساب مشتریان" Height="40" Margin="10,5" 
                            Click="BtnCustomers_Click" Background="#34495E" 
                            Foreground="White" BorderThickness="0"/>
                    <Button Content="ترانسپورت و گمرک" Height="40" Margin="10,5" 
                            Click="BtnTransport_Click" Background="#34495E" 
                            Foreground="White" BorderThickness="0"/>
                    <Button Content="پیگیری محموله" Height="40" Margin="10,5" 
                            Click="BtnShipmentTracking_Click" Background="#34495E" 
                            Foreground="White" BorderThickness="0"/>
                    <Button Content="مصارف گمرک" Height="40" Margin="10,5" 
                            Click="BtnExpenses_Click" Background="#34495E" 
                            Foreground="White" BorderThickness="0"/>
                    <Button Content="چاپ گزارش" Height="40" Margin="10,5" 
                            Click="BtnPrint_Click" Background="#34495E" 
                            Foreground="White" BorderThickness="0"/>
                    <Button Content="پشتیبان‌گیری" Height="40" Margin="10,5" 
                            Click="BtnBackup_Click" Background="#34495E" 
                            Foreground="White" BorderThickness="0"/>
                    <Button Content="خروج" Height="40" Margin="10,20,10,10" 
                            Click="BtnExit_Click" Background="#E74C3C" 
                            Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        
        <!-- Main Content Area -->
        <Border Grid.Column="1" Background="#ECF0F1">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </Border>
    </Grid>
</Window>
