<Window x:Class="FinancialSystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ورود به سیستم" Height="350" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,30">
            <TextBlock Text="سیستم مدیریت مالی و حسابداری" 
                       FontSize="20" FontWeight="Bold" 
                       Foreground="#333" HorizontalAlignment="Center"/>
            <TextBlock Text="لطفاً وارد شوید" 
                       FontSize="14" Foreground="#666" 
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>
        
        <!-- Login Form -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="نام کاربری:" Margin="0,0,0,5" Foreground="#333"/>
            <TextBox x:Name="txtUsername" Height="35" Margin="0,0,0,20" 
                     FontSize="14" Padding="5" BorderBrush="#ccc"/>
            
            <TextBlock Text="رمز عبور:" Margin="0,0,0,5" Foreground="#333"/>
            <PasswordBox x:Name="txtPassword" Height="35" Margin="0,0,0,20" 
                         FontSize="14" Padding="5" BorderBrush="#ccc"/>
            
            <TextBlock x:Name="txtError" Text="" Foreground="Red" 
                       Margin="0,0,0,10" Visibility="Collapsed"/>
        </StackPanel>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="ورود" Width="120" Height="40" FontSize="14"
                    Background="#4CAF50" Foreground="White" BorderThickness="0"
                    Click="BtnLogin_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
