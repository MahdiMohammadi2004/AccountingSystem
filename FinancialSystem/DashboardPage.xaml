<Page x:Class="FinancialSystem.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="داشبورد مالی">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0" Text="داشبورد مالی" FontSize="24" FontWeight="Bold" 
                       Margin="0,0,0,20" HorizontalAlignment="Center"/>
            
            <!-- Summary Cards -->
            <UniformGrid Grid.Row="1" Rows="2" Columns="4" Margin="0,0,0,20">
                <Border Background="#3498DB" CornerRadius="10" Margin="5">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="مجموع آمد" Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtTotalIncome" Text="0" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <Border Background="#E74C3C" CornerRadius="10" Margin="5">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="مجموع رفت" Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtTotalExpense" Text="0" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <Border Background="#2ECC71" CornerRadius="10" Margin="5">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="سود خالص" Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtNetProfit" Text="0" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <Border Background="#F39C12" CornerRadius="10" Margin="5">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="بیلانس فعلی" Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtCurrentBalance" Text="0" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            
            <!-- Date Filter -->
            <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="گزارش بر اساس بازه زمانی" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="روزانه" Width="80" Margin="5" Click="BtnDaily_Click"/>
                        <Button Content="هفته‌وار" Width="80" Margin="5" Click="BtnWeekly_Click"/>
                        <Button Content="ماه‌وار" Width="80" Margin="5" Click="BtnMonthly_Click"/>
                        <Button Content="سالانه" Width="80" Margin="5" Click="BtnYearly_Click"/>
                        <Button Content="انتخابی" Width="80" Margin="5" Click="BtnCustom_Click"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <DatePicker x:Name="dpStartDate" Width="150" Margin="5"/>
                        <TextBlock Text="تا" VerticalAlignment="Center" Margin="10,0"/>
                        <DatePicker x:Name="dpEndDate" Width="150" Margin="5"/>
                        <Button Content="نمایش" Width="80" Margin="10,0,0,0" Click="BtnShowCustom_Click"/>
                    </StackPanel>
                    
                    <DataGrid x:Name="dgDashboard" AutoGenerateColumns="False" 
                              CanUserAddRows="False" Margin="0,20,0,0" Height="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="100"/>
                            <DataGridTextColumn Header="تفصیلات" Binding="{Binding Details}" Width="200"/>
                            <DataGridTextColumn Header="آمد" Binding="{Binding Income}" Width="100"/>
                            <DataGridTextColumn Header="رفت" Binding="{Binding Expense}" Width="100"/>
                            <DataGridTextColumn Header="بیلانس" Binding="{Binding Balance}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
