<Page x:Class="FinancialSystem.ExpensesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Customs Expenses">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Customs and Transport Expenses" FontSize="24" FontWeight="Bold" 
                   Margin="0,0,0,20" HorizontalAlignment="Center"/>
        
        <DataGrid Grid.Row="1" x:Name="dgExpenses" AutoGenerateColumns="False" 
                  CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding ExpenseDate}" Width="100"/>
                <DataGridTextColumn Header="Type" Binding="{Binding ExpenseType}" Width="150"/>
                <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="100"/>
                <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="80"/>
                <DataGridTextColumn Header="Paid To" Binding="{Binding PaidTo}" Width="150"/>
                <DataGridTextColumn Header="Receipt No" Binding="{Binding ReceiptNumber}" Width="100"/>
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
