<Page x:Class="FinancialSystem.ShipmentTrackingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Shipment Tracking">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Shipment Tracking" FontSize="24" FontWeight="Bold" 
                   Margin="0,0,0,20" HorizontalAlignment="Center"/>
        
        <DataGrid Grid.Row="1" x:Name="dgTracking" AutoGenerateColumns="False" 
                  CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Shipment No" Binding="{Binding ShipmentNumber}" Width="100"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"/>
                <DataGridTextColumn Header="Status Date" Binding="{Binding StatusDate}" Width="120"/>
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="300"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
