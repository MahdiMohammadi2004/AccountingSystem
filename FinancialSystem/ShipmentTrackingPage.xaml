<Page x:Class="FinancialSystem.ShipmentTrackingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="پیگیری محموله">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="پیگیری وضعیت محموله" FontSize="24" FontWeight="Bold" 
                   Margin="0,0,0,20" HorizontalAlignment="Center"/>
        
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="انتخاب محموله:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="cmbShipments" Grid.Column="1" Width="300" SelectionChanged="CmbShipments_SelectionChanged"/>
                <Button Grid.Column="2" Content="بروزرسانی وضعیت" Width="150" Margin="20,0,0,0" 
                        Click="BtnUpdateStatus_Click" Background="#3498DB" Foreground="White" BorderThickness="0"/>
            </Grid>
        </Border>
        
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="txtShipmentInfo" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>
                    
                    <ItemsControl x:Name="icStatusHistory">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#ECF0F1" CornerRadius="5" Padding="10" Margin="0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Text="{Binding Status}" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Notes}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding StatusDate}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <TextBlock Text="بروزرسانی وضعیت فعلی:" FontSize="14" FontWeight="Bold" Margin="0,20,0,10"/>
                    <ComboBox x:Name="cmbNewStatus" Width="300" HorizontalAlignment="Left">
                        <ComboBoxItem Content="ثبت محموله"/>
                        <ComboBoxItem Content="آماده ارسال"/>
                        <ComboBoxItem Content="حرکت از مبدأ"/>
                        <ComboBoxItem Content="در مسیر"/>
                        <ComboBoxItem Content="رسیدن به مرز"/>
                        <ComboBoxItem Content="گمرک"/>
                        <ComboBoxItem Content="ترخیص"/>
                        <ComboBoxItem Content="انتقال به مقصد"/>
                        <ComboBoxItem Content="رسیدن به انبار"/>
                    </ComboBox>
                    
                    <TextBox x:Name="txtStatusNotes" Width="500" Height="60" 
                             TextWrapping="Wrap" AcceptsReturn="True" 
                             Margin="0,10,0,0" VerticalAlignment="Left"/>
                    
                    <Button Content="ثبت وضعیت جدید" Width="150" Height="35" 
                            Click="BtnSaveStatus_Click" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Background="#27AE60" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
