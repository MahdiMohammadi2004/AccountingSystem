<Page x:Class="FinancialSystem.JournalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Journal">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Financial Transactions Journal" FontSize="24" FontWeight="Bold" 
                   Margin="0,0,0,20" HorizontalAlignment="Center"/>
        
        <DataGrid Grid.Row="1" x:Name="dgJournal" AutoGenerateColumns="False" 
                  CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="100"/>
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="250"/>
                <DataGridTextColumn Header="Income" Binding="{Binding Income}" Width="100"/>
                <DataGridTextColumn Header="Expense" Binding="{Binding Expense}" Width="100"/>
                <DataGridTextColumn Header="Balance" Binding="{Binding Balance}" Width="100"/>
                <DataGridTextColumn Header="Doc Number" Binding="{Binding DocumentNumber}" Width="100"/>
                <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
