<Page x:Class="FinancialSystem.TransportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Transport & Customs">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Transport and Customs" FontSize="24" FontWeight="Bold" 
                   Margin="0,0,0,20" HorizontalAlignment="Center"/>
        
        <DataGrid Grid.Row="1" x:Name="dgTransport" AutoGenerateColumns="False" 
                  CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Shipment No" Binding="{Binding ShipmentNumber}" Width="100"/>
                <DataGridTextColumn Header="Origin" Binding="{Binding OriginCity}" Width="100"/>
                <DataGridTextColumn Header="Destination" Binding="{Binding DestinationCity}" Width="100"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                <DataGridTextColumn Header="Company" Binding="{Binding TransportCompany}" Width="120"/>
                <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
