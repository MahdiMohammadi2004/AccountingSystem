<Page x:Class="AccountingSystem.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="داشبورد مالی">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="داشبورد مالی" FontSize="24" FontWeight="Bold" 
                       Foreground="#333" Margin="0,0,0,20"/>
            
            <!-- Summary Cards -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Total Coming -->
                <Border Grid.Column="0" Background="#4CAF50" CornerRadius="8" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="مجموع آمد" Foreground="White" FontSize="14"/>
                        <TextBlock x:Name="txtTotalComing" Text="0" Foreground="White" 
                                   FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Total Going -->
                <Border Grid.Column="1" Background="#F44336" CornerRadius="8" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="مجموع رفت" Foreground="White" FontSize="14"/>
                        <TextBlock x:Name="txtTotalGoing" Text="0" Foreground="White" 
                                   FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Total Income -->
                <Border Grid.Column="2" Background="#2196F3" CornerRadius="8" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="مجموع درآمد" Foreground="White" FontSize="14"/>
                        <TextBlock x:Name="txtTotalIncome" Text="0" Foreground="White" 
                                   FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Total Expense -->
                <Border Grid.Column="3" Background="#FF9800" CornerRadius="8" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="مجموع مصارف" Foreground="White" FontSize="14"/>
                        <TextBlock x:Name="txtTotalExpense" Text="0" Foreground="White" 
                                   FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Second Row -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Current Balance -->
                <Border Grid.Column="0" Background="#9C27B0" CornerRadius="8" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="بیلانس فعلی" Foreground="White" FontSize="14"/>
                        <TextBlock x:Name="txtCurrentBalance" Text="0" Foreground="White" 
                                   FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Net Income -->
                <Border Grid.Column="1" Background="#607D8B" CornerRadius="8" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="درآمد خالص (سود/ضرر)" Foreground="White" FontSize="14"/>
                        <TextBlock x:Name="txtNetIncome" Text="0" Foreground="White" 
                                   FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
