<Page x:Class="FinancialSystem.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="گزارش‌ها">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="گزارش‌های مالی" FontSize="24" FontWeight="Bold" 
                   Foreground="#333" Margin="0,0,0,20"/>
        
        <!-- Report Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="گزارش روزانه" Width="150" Height="40" Margin="5"
                    Background="#4CAF50" Foreground="White" Click="BtnDailyReport_Click"/>
            <Button Content="گزارش هفته‌وار" Width="150" Height="40" Margin="5"
                    Background="#2196F3" Foreground="White" Click="BtnWeeklyReport_Click"/>
            <Button Content="گزارش ماه‌وار" Width="150" Height="40" Margin="5"
                    Background="#FF9800" Foreground="White" Click="BtnMonthlyReport_Click"/>
            <Button Content="گزارش سالانه" Width="150" Height="40" Margin="5"
                    Background="#9C27B0" Foreground="White" Click="BtnYearlyReport_Click"/>
        </StackPanel>
        
        <!-- Report Result -->
        <Border Grid.Row="2" Background="White" BorderBrush="#ccc" BorderThickness="1" CornerRadius="5" Padding="20">
            <TextBlock x:Name="txtReportResult" FontSize="16" Foreground="#333"
                       Text="لطفاً نوع گزارش را انتخاب کنید"/>
        </Border>
    </Grid>
</Page>
