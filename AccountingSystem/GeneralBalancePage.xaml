<Page x:Class="FinancialSystem.GeneralBalancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="بیلانس عمومی">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="بیلانس عمومی" FontSize="24" FontWeight="Bold" 
                       Foreground="#333"/>
            <Button Content="افزودن سند جدید" Width="150" Height="35" 
                    Margin="20,0,0,0" Background="#4CAF50" Foreground="White"
                    Click="BtnAdd_Click"/>
        </StackPanel>
        
        <!-- Data Grid -->
        <DataGrid x:Name="dgGeneralBalance" Grid.Row="1" AutoGenerateColumns="True"
                  CanUserAddRows="False" IsReadOnly="True"
                  AlternatingRowBackground="#F5F5F5"/>
    </Grid>
</Page>
